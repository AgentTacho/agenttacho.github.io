---
// Hero (brainstorm 18, page structure 2): headline and download on the left,
// the clay mascot on the right, facing the text. Stacks on phones.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import mascot from '~/assets/agenttacho/mascot.webp';
import { GITHUB } from '~/navigation';
import type { Release } from '~/utils/release';

export interface Props {
  release: Release;
}

const { release } = Astro.props;
---

<section class="relative not-prose">
  <div
    class="mx-auto grid max-w-6xl items-center gap-10 px-4 pt-10 pb-6 sm:px-6 md:grid-cols-[1.4fr_1fr] md:pt-16 lg:gap-16"
  >
    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-eyebrow">Menu bar app for macOS</p>
      <h1
        class="mt-3 font-heading text-5xl font-bold leading-[1.04] tracking-tight text-heading md:text-6xl lg:text-[4.25rem]"
      >
        Usage at a glance.<br />
        <span class="text-accent">Nothing more.</span>
      </h1>
      <p class="mt-6 max-w-xl text-xl leading-relaxed text-muted">
        Plan limits and budgets for Claude Code, Codex and OpenCode, in one line of your menu bar.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="btn-primary gap-2" href={release.dmgUrl} data-download>
          <Icon name="tabler:download" class="h-5 w-5" />
          Download AgentTacho
          <span class="font-normal opacity-80">v{release.version}</span>
        </a>
        <a class="btn" href={GITHUB} target="_blank" rel="noopener noreferrer">
          View on GitHub
          <Icon name="tabler:brand-github" class="ml-2 h-5 w-5" />
        </a>
      </div>
      <div class="mt-4 text-sm text-muted">
        Free and open source · macOS 14+ on Apple Silicon · signed and notarized ·&nbsp;
        <details class="inline">
          <summary class="inline cursor-pointer underline decoration-dotted underline-offset-2">or Homebrew</summary>
          <code
            class="mt-2 block w-fit select-all rounded-md border border-line bg-surface px-2 py-1 font-mono text-xs text-default"
            >brew install --cask agenttacho/tap/agenttacho</code
          >
        </details>
      </div>
    </div>
    <div class="flex justify-center">
      <Image
        src={mascot}
        alt="AgentTacho mascot"
        loading="eager"
        widths={[240, 360, 480]}
        sizes="(min-width: 768px) 340px, 240px"
        class="w-60 drop-shadow-[0_28px_30px_rgba(5,40,38,0.18)] md:w-[340px] dark:drop-shadow-[0_28px_40px_rgba(0,0,0,0.55)]"
      />
    </div>
  </div>
</section>
