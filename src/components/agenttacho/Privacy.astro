---
// Privacy (brainstorm 18, page structure 6), from the README's "Security and
// privacy" section as of 2026-10-21 (spec 033 free reset tickets). Keep it in
// step with that section.
import { Icon } from 'astro-icon/components';
import { PRIVACY_README } from '~/navigation';

const points = [
  {
    icon: 'tabler:key',
    title: 'Your agents’ own sign-in, read only',
    body: 'To show plan limits and free limit resets, AgentTacho reads the sign-in tokens Claude Code and Codex already have, and sends each one only to that provider’s usage endpoints. It never refreshes or changes a login, and never redeems a reset.',
  },
  {
    icon: 'tabler:cookie-off',
    title: 'No browser, no cookies',
    body: 'It never opens your browser’s data or its cookies. Token counts and spend come from the files your agents write on this Mac.',
  },
  {
    icon: 'tabler:eye-off',
    title: 'No telemetry',
    body: 'Besides asking Anthropic and ChatGPT for your plan limits and free limit resets, the only automatic request is the update check, which you can turn off. Price lists download only when you ask.',
  },
  {
    icon: 'tabler:file-search',
    title: 'Every read written down',
    body: 'The README lists each file and keychain item AgentTacho reads, what for, and what it keeps.',
  },
];
---

<section id="privacy" class="not-prose mx-auto max-w-6xl scroll-mt-[72px] px-4 pt-24 sm:px-6">
  <div class="rounded-3xl bg-tint px-6 py-12 sm:px-10">
    <p class="text-center text-sm font-bold uppercase tracking-wider text-eyebrow">Privacy</p>
    <h2 class="mt-2 text-center font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">
      Your data stays on your Mac.
    </h2>
    <ul class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
      {
        points.map((point) => (
          <li class="flex gap-4">
            <Icon name={point.icon} class="mt-1 h-7 w-7 shrink-0 text-accent" />
            <div>
              <h3 class="font-heading text-lg font-bold text-heading">{point.title}</h3>
              <p class="mt-1 leading-relaxed text-muted">{point.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-10 text-center">
      <a
        class="font-semibold text-link underline underline-offset-4"
        href={PRIVACY_README}
        target="_blank"
        rel="noopener noreferrer">Read exactly what it reads</a
      >
    </p>
  </div>
</section>
