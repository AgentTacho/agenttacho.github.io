---
// AgentTacho logo: the app icon next to the name.
import { Image } from 'astro:assets';
import icon from '~/assets/agenttacho/icon.png';
---

<span
  class="self-center inline-flex items-center gap-2.5 font-heading text-xl font-bold text-heading"
  aria-label="AgentTacho home"
>
  <Image src={icon} alt="" width={32} height={32} class="h-8 w-8" loading="eager" />
  AgentTacho
</span>
