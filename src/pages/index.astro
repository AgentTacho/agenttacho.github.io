---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/agentmeter/Hero.astro';
import MenuBarStrip from '~/components/agentmeter/MenuBarStrip.astro';
import FeatureGrid from '~/components/agentmeter/FeatureGrid.astro';
import SmallThings from '~/components/agentmeter/SmallThings.astro';
import Privacy from '~/components/agentmeter/Privacy.astro';
import Compare from '~/components/agentmeter/Compare.astro';
import ClosingCta from '~/components/agentmeter/ClosingCta.astro';

import { getLatestRelease } from '~/utils/release';

const metadata = {
  title: 'AgentMeter: usage at a glance',
  ignoreTitleTemplate: true,
};

const release = await getLatestRelease(fetch, process.env.GITHUB_TOKEN);
---

<Layout metadata={metadata}>
  <Hero release={release} />
  <MenuBarStrip />
  <FeatureGrid />
  <SmallThings />
  <Privacy />
  <Compare />
  <ClosingCta release={release} />
</Layout>
